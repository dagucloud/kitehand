{
  "name": "kitehand-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "check": "astro check && tsc -p worker/tsconfig.json --noEmit",
    "serve": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261013.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  }
}
