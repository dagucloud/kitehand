---
// The page shell: meta tags for search and sharing, the fonts each language
// needs, and visit statistics on kitehand.ai.
import Analytics from "../components/Analytics.astro";
import fonts from "../data/fonts.json";
import "../styles/fonts.css";
import "../styles/global.css";
import type { Copy } from "../i18n/copy";

// The faces the first screen is drawn in, fetched before the stylesheet asks
// for them: the headline's and the body's.
const FIRST: Record<string, string[]> = {
  en: ["Gloock|400", "Hanken Grotesk|400"],
  ja: ["Shippori Mincho B1|800", "Zen Kaku Gothic New|400"],
};

interface Props {
  copy: Copy;
  // This page's path, and its counterpart's in the other language.
  path: string;
  alternate: string;
  title?: string;
  description?: string;
}

const { copy, path, alternate, title = copy.meta.title, description = copy.meta.description } = Astro.props;
const site = Astro.site!;
const canonical = new URL(path, site).href;
const en = copy.lang === "en" ? path : alternate;
const ja = copy.lang === "ja" ? path : alternate;
const preload = FIRST[copy.lang].map((key) => (fonts as Record<string, { file: string }>)[key]?.file).filter(Boolean);
---

<!doctype html>
<html lang={copy.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(en, site).href} />
    <link rel="alternate" hreflang="ja" href={new URL(ja, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(en, site).href} />
    <script is:inline src="/lang.js"></script>
    <link rel="icon" href="/icon-small.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-256.png" />
    <meta name="theme-color" content="#f6f3ec" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kitehand" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(copy.meta.og, site).href} />
    <meta property="og:locale" content={copy.lang === "ja" ? "ja_JP" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    {preload.map((file) => <link rel="preload" href={file} as="font" type="font/woff2" crossorigin />)}
    <slot name="head" />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
