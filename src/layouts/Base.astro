---
// The page shell: meta tags for search and sharing, the fonts each language
// needs, and visit statistics on kitehand.ai.
import Analytics from "../components/Analytics.astro";
import "../styles/global.css";
import type { Copy } from "../i18n/copy";

interface Props {
  copy: Copy;
  // This page's path, and its counterpart's in the other language.
  path: string;
  alternate: string;
  title?: string;
  description?: string;
}

const { copy, path, alternate, title = copy.meta.title, description = copy.meta.description } = Astro.props;
const site = Astro.site!;
const canonical = new URL(path, site).href;
const en = copy.lang === "en" ? path : alternate;
const ja = copy.lang === "ja" ? path : alternate;
const fonts =
  copy.lang === "ja"
    ? "family=Gloock&family=Shippori+Mincho+B1:wght@600;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Hanken+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@300;400;500"
    : "family=Gloock&family=Hanken+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@300;400;500";
---

<!doctype html>
<html lang={copy.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(en, site).href} />
    <link rel="alternate" hreflang="ja" href={new URL(ja, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(en, site).href} />
    <script is:inline src="/lang.js"></script>
    <link rel="icon" href="/icon-small.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-256.png" />
    <meta name="theme-color" content="#f6f3ec" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kitehand" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(copy.meta.og, site).href} />
    <meta property="og:locale" content={copy.lang === "ja" ? "ja_JP" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
