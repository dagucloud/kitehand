---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { COPY } from "../i18n/copy";
import Base from "../layouts/Base.astro";

const copy = COPY.en;
---

<Base copy={copy} path="/404/" alternate="/ja/" title={`${copy.notFound.title} · Kitehand`}>
  <Header copy={copy} alternate="/ja/" home={false} />
  <main class="job-hero" style="padding-bottom: 160px">
    <div class="wrap">
      <h1>{copy.notFound.title}</h1>
      <p class="lede">{copy.notFound.body}</p>
      <p style="margin-top: 32px"><a class="btn btn--shu" href="/">{copy.notFound.home} <span class="arrow">→</span></a></p>
    </div>
  </main>
  <Footer copy={copy} alternate="/ja/" />
</Base>
