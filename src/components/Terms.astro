---
import type { Copy } from "../i18n/copy";
import { TERMS } from "../i18n/terms";
import Base from "../layouts/Base.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const terms = TERMS[copy.lang];
const base = copy.lang === "ja" ? "/ja/" : "/";
const alternate = `${copy.lang === "ja" ? "/" : "/ja/"}terms/`;
---

<Base copy={copy} path={`${base}terms/`} alternate={alternate} title={`${terms.title} · Kitehand`}>
  <Header copy={copy} alternate={alternate} home={false} />
  <main class="job-hero" style="padding-bottom: 120px">
    <div class="wrap prose">
      <h1>{terms.title}</h1>
      <p>{terms.updated}</p>
      {terms.intro.map((p) => <p>{p}</p>)}
      {
        terms.sections.map((section) => (
          <section>
            <h2>{section.title}</h2>
            {section.body.map((part) =>
              Array.isArray(part) ? (
                <ul>
                  {part.map((item) => (
                    <li set:html={item} />
                  ))}
                </ul>
              ) : (
                <p set:html={part} />
              ),
            )}
          </section>
        ))
      }
    </div>
  </main>
  <Footer copy={copy} alternate={alternate} />
</Base>
