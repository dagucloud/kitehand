---
import type { Copy } from "../i18n/copy";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: copy.faq.items.map((i) => ({ "@type": "Question", name: i.q, acceptedAnswer: { "@type": "Answer", text: i.a } })),
};
---

<section class="section faq" id="faq">
  <div class="wrap">
    <span class="eyebrow">{copy.faq.eyebrow}</span>
    <h2 class="section-title">{copy.faq.title}</h2>
    <div class="list">
      {
        copy.faq.items.map((item, i) => (
          <details open={i === 0}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
</section>
