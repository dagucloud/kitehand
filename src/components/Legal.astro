---
// A legal page: its title, the date it last changed, and its numbered sections.
import type { Copy } from "../i18n/copy";
import type { LegalDoc } from "../i18n/terms";
import Base from "../layouts/Base.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

interface Props {
  copy: Copy;
  doc: LegalDoc;
  slug: string;
}

const { copy, doc, slug } = Astro.props;
const base = copy.lang === "ja" ? "/ja/" : "/";
const alternate = `${copy.lang === "ja" ? "/" : "/ja/"}${slug}/`;
---

<Base copy={copy} path={`${base}${slug}/`} alternate={alternate} title={`${doc.title} · Kitehand`}>
  <Header copy={copy} alternate={alternate} home={false} />
  <main class="job-hero" style="padding-bottom: 120px">
    <div class="wrap prose">
      <h1>{doc.title}</h1>
      <p>{doc.updated}</p>
      {doc.intro.map((p) => <p>{p}</p>)}
      {
        doc.sections.map((section) => (
          <section>
            <h2>{section.title}</h2>
            {section.body.map((part) =>
              Array.isArray(part) ? (
                <ul>
                  {part.map((item) => (
                    <li set:html={item} />
                  ))}
                </ul>
              ) : (
                <p set:html={part} />
              ),
            )}
          </section>
        ))
      }
    </div>
  </main>
  <Footer copy={copy} alternate={alternate} />
</Base>
