---
import type { Copy } from "../i18n/copy";
import { START } from "../lib/links";
import Phrases from "./Phrases.astro";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
---

<section class="section ranking" id="ranking" data-ranking hidden>
  <div class="wrap">
    <span class="eyebrow">{copy.ranking.eyebrow}</span>
    <h2 class="section-title"><Phrases text={copy.ranking.title} /></h2>
    <p class="ranking-lede">{copy.ranking.lede}</p>
    <ol class="ranking-list" data-ranking-list data-by={copy.ranking.by} data-used={copy.ranking.used} data-used-once={copy.ranking.usedOnce}></ol>
    <p class="ranking-foot"><a class="btn btn--ink" href={START} data-start="ranking">{copy.ranking.cta} <span class="arrow">→</span></a></p>
  </div>
</section>
