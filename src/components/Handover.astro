---
// Early access: a company hands a job over, with the job it pasted or the
// sample it read carried along. Requests reach the team through Web3Forms,
// the form service the Dagu website uses.
import Phrases from "./Phrases.astro";
import type { Copy } from "../i18n/copy";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const h = copy.handover;
---

<section class="section handover" id="handover">
  <div class="wrap grid">
    <div>
      <span class="eyebrow">{h.eyebrow}</span>
      <h2 class="section-title"><Phrases text={h.title} /></h2>
      <p class="lede">{h.lede}</p>
    </div>
    <form data-handover data-lang={copy.lang} data-sending={h.sending} data-error={h.error} data-pasted={h.pasted} novalidate>
      <div class="field">
        <label for="ho-email">{h.email}</label>
        <input id="ho-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="ho-company">{h.company}</label>
        <input id="ho-company" name="company" autocomplete="organization" required />
      </div>
      <div class="field">
        <label for="ho-job">{h.job}</label>
        <textarea id="ho-job" name="job" placeholder={h.jobHint}></textarea>
      </div>
      <p class="note" data-note aria-live="polite"></p>
      <button class="btn btn--shu" type="submit">{h.submit} <span class="arrow">→</span></button>
      <div class="done" role="status">{h.done}</div>
    </form>
  </div>
</section>

<script>
  import { track } from "../lib/analytics";
  import { formatHires, tally, type Diagnosis } from "../lib/diagnosis";

  const WEB3FORMS_KEY = "81d327c7-60e9-4461-a0c4-d6fbc0cab56a";

  const form = document.querySelector<HTMLFormElement>("[data-handover]")!;
  const note = form.querySelector<HTMLElement>("[data-note]")!;
  const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
  const job = form.querySelector<HTMLTextAreaElement>("[name=job]")!;
  let reading: { d: Diagnosis; slug: string } | null = null;

  // A sample read on this page comes along with the request.
  window.addEventListener("kitehand:read", (event) => {
    reading = (event as CustomEvent<{ d: Diagnosis; slug: string; text: string }>).detail;
  });

  // A job pasted into the reader lands here, so nobody pastes it twice.
  window.addEventListener("kitehand:paste", (event) => {
    job.value = (event as CustomEvent<{ text: string }>).detail.text;
    reading = null;
    note.textContent = form.dataset.pasted ?? "";
    form.scrollIntoView({ behavior: "smooth", block: "center" });
    form.querySelector<HTMLInputElement>("[name=email]")!.focus({ preventScroll: true });
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const label = button.innerHTML;
    button.disabled = true;
    button.textContent = form.dataset.sending ?? "";
    note.textContent = "";
    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "content-type": "application/json", accept: "application/json" },
        body: JSON.stringify({
          access_key: WEB3FORMS_KEY,
          subject: `Kitehand: a job handed over by ${data.get("company")}`,
          from_name: "Kitehand Website",
          email: data.get("email"),
          company: data.get("company"),
          job: data.get("job"),
          sample: reading ? `${reading.d.title} (${formatHires(tally(reading.d).hires)})` : "",
          lang: form.dataset.lang,
        }),
      });
      const result = (await response.json().catch(() => ({}))) as { success?: boolean };
      if (!response.ok || !result.success) throw new Error(String(response.status));
      form.classList.add("is-done");
      track("handover_sent", { slug: reading?.slug ?? "", read: reading !== null });
    } catch {
      note.textContent = form.dataset.error ?? "";
    } finally {
      button.disabled = false;
      button.innerHTML = label;
    }
  });
</script>
