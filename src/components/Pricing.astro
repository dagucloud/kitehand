---
// The plans side by side: Free, which starts in the app with one hand and one
// job, and Own Key and Pro, priced per hand and applied for at the foot of the
// page, with what Pro comes to beside a person's wage.
import Phrases from "./Phrases.astro";
import type { Copy } from "../i18n/copy";
import { START } from "../lib/links";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const p = copy.pricing;
---

<section class="section pricing" id="pricing">
  <div class="wrap">
    <span class="eyebrow">{p.eyebrow}</span>
    <h2 class="section-title"><Phrases text={p.title} /></h2>
    <div class="plans">
      {
        p.plans.map((plan) => (
          <div class:list={["plan", plan.featured && "is-featured"]}>
            <h3>{plan.name}</h3>
            <p class="plan-lede">{plan.lede}</p>
            <p class="price">
              <span class="amount">{plan.price}</span>
              <span class="per">{plan.per}</span>
            </p>
            {plan.featured && <p class="anchor">{p.anchor}</p>}
            <ul class="includes">
              {plan.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {plan.apply && <p class="yearly">{p.yearly}</p>}
            <div class="plan-foot">
              <a class:list={["btn", plan.featured ? "btn--shu" : "btn--ghost"]} href={plan.apply ? "#apply" : START} data-start={plan.id} data-plan={plan.apply ? plan.name : undefined}>
                {plan.cta} <span class="arrow">→</span>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { track } from "../lib/analytics";

  // The prices count as seen once the plans are half on screen, and a start
  // from a plan is counted by which.
  const plans = document.querySelector(".pricing .plans");
  if (plans) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          track("pricing_viewed", {});
          observer.disconnect();
        }
      },
      { threshold: 0.5 },
    );
    observer.observe(plans);
  }
  document.querySelectorAll<HTMLAnchorElement>("[data-start]").forEach((link) =>
    link.addEventListener("click", () => track("start_clicked", { from: "pricing", plan: link.dataset.start ?? "" })),
  );
  // Applying for a plan chooses it in the form at the foot of the page.
  document.querySelectorAll<HTMLAnchorElement>(".pricing [data-plan]").forEach((link) =>
    link.addEventListener("click", () => {
      const choice = document.querySelector<HTMLInputElement>(`[data-apply] [name=plan][value="${link.dataset.plan}"]`);
      if (choice) choice.checked = true;
    }),
  );
</script>
