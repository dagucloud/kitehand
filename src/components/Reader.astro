---
// Examples of work owners often do themselves, read ahead of time: choosing
// one shows, in the card right below, what the secretary would take. Work of
// the owner's own goes with their application, at the foot of the page.
import { SAMPLES } from "../data/samples";
import type { Copy } from "../i18n/copy";
import { json, readerConfig } from "../lib/reader-config";
import Phrases from "./Phrases.astro";
import ResultCard from "./ResultCard.astro";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const lang = copy.lang;
const example = SAMPLES[0];
---

<section class="section read" id="read">
  <div class="wrap">
    <span class="eyebrow">{copy.read.eyebrow}</span>
    <h2 class="section-title"><Phrases text={copy.read.title} /></h2>
    <p class="lede">{copy.read.lede}</p>
    <div class="chips" role="group" aria-label={copy.read.pick}>
      {SAMPLES.map((s) => <button type="button" class="chip" data-sample={s.slug} aria-pressed={s.slug === example.slug ? "true" : "false"}>{s.diagnosis[lang].title}</button>)}
    </div>
  </div>
  <div class="wrap result-wrap">
    <ResultCard copy={copy} d={example.diagnosis[lang]} label={copy.read.example} slug={example.slug} interactive />
  </div>
  <div class="toast" data-toast role="status"></div>
  <script type="application/json" id="reader-config" set:html={json(readerConfig(copy))} />
</section>

<script>
  import "../scripts/reader.ts";
</script>
