---
import Phrases from "./Phrases.astro";
import type { Copy } from "../i18n/copy";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const c = copy.contrast;
---

<section class="section contrast" id="contrast">
  <div class="wrap">
    <span class="eyebrow">{c.eyebrow}</span>
    <h2 class="section-title"><Phrases text={c.title} /></h2>
    <table>
      <thead>
        <tr><th scope="col">{c.left}</th><th scope="col">{c.right}</th></tr>
      </thead>
      <tbody>
        {
          c.rows.map(([agent, kitehand]) => (
            <tr>
              <td>{agent}</td>
              <td>{kitehand}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
