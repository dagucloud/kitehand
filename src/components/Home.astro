---
import type { Copy } from "../i18n/copy";
import Base from "../layouts/Base.astro";
import Contrast from "./Contrast.astro";
import Faq from "./Faq.astro";
import Footer from "./Footer.astro";
import Handover from "./Handover.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import How from "./How.astro";
import Morning from "./Morning.astro";
import Reader from "./Reader.astro";
import Trust from "./Trust.astro";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const path = copy.lang === "ja" ? "/ja/" : "/";
---

<Base copy={copy} path={path} alternate={copy.other.home}>
  <Header copy={copy} alternate={copy.other.home} />
  <main>
    <Hero copy={copy} />
    <Reader copy={copy} />
    <Morning copy={copy} />
    <How copy={copy} />
    <Contrast copy={copy} />
    <Trust copy={copy} />
    <Faq copy={copy} />
    <Handover copy={copy} />
  </main>
  <Footer copy={copy} alternate={copy.other.home} />
</Base>
