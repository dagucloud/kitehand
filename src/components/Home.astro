---
import type { Copy } from "../i18n/copy";
import Base from "../layouts/Base.astro";
import Apply from "./Apply.astro";
import Compare from "./Compare.astro";
import Day from "./Day.astro";
import Facts from "./Facts.astro";
import Faq from "./Faq.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import How from "./How.astro";
import Pricing from "./Pricing.astro";
import Reader from "./Reader.astro";
import Trust from "./Trust.astro";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const path = copy.lang === "ja" ? "/ja/" : "/";
---

<Base copy={copy} path={path} alternate={copy.other.home}>
  <Header copy={copy} alternate={copy.other.home} />
  <main>
    <Hero copy={copy} />
    <Facts copy={copy} />
    <Reader copy={copy} />
    <Day copy={copy} />
    <How copy={copy} />
    <Compare copy={copy} />
    <Trust copy={copy} />
    <Pricing copy={copy} />
    <Faq copy={copy} />
    <Apply copy={copy} />
  </main>
  <Footer copy={copy} alternate={copy.other.home} />
</Base>
