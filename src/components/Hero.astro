---
// The top of the home page: what Kitehand is, in words and on screen. The
// film's working day plays silently beside the promise, its lines burned in.
import type { Copy } from "../i18n/copy";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const lang = copy.lang;
---

<section class="hero">
  <div class="wrap grid">
    <div>
      <span class="badge rise rise-1"><span class="dot"></span>{copy.hero.badge}</span>
      <p class="kicker rise rise-2">{copy.hero.kicker}</p>
      <h1 class="rise rise-3"><span>{copy.hero.title[0]}</span><span>{copy.hero.title[1]}</span></h1>
      <p class="lede rise rise-4">{copy.hero.lede}</p>
      <div class="actions rise rise-5">
        <a class="btn btn--shu" href="#read">{copy.hero.actions[0]} <span class="arrow">→</span></a>
        <a class="btn btn--ghost" href="#film">▶ {copy.hero.actions[1]}</a>
      </div>
    </div>
    <video
      class="hero-film rise rise-5"
      src={`/hero-loop-${lang}.mp4`}
      poster={`/hero-poster-${lang}.jpg`}
      aria-label={copy.morning.title}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"></video>
  </div>
</section>

<script>
  // Motion stays still for visitors who ask for less of it.
  const film = document.querySelector<HTMLVideoElement>(".hero-film");
  if (film && matchMedia("(prefers-reduced-motion: reduce)").matches) {
    film.removeAttribute("autoplay");
    film.pause();
  }
</script>
