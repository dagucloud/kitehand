---
// The top of the home page: who Kitehand is for and what it does, beside the
// day's roster of the company's work. Kitehand covers the work nobody is free
// for, people keep theirs, and the one exception waits on the manager's
// phone until they approve it.
import type { Copy } from "../i18n/copy";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const h = copy.hero;
const r = h.roster;
const p = h.phone;
---

<section class="hero">
  <div class="wrap grid">
    <div>
      <a class="badge rise rise-1" href="#apply"><span class="dot"></span>{h.badge} <span class="arrow">→</span></a>
      <p class="kicker rise rise-2">{h.kicker}</p>
      <h1 class="rise rise-3"><span>{h.title[0]}</span><span>{h.title[1]}</span></h1>
      <p class="lede rise rise-4">{h.lede}</p>
      <div class="actions rise rise-5">
        <a class="btn btn--shu" href="#apply">{h.actions[0]} <span class="arrow">→</span></a>
        <a class="btn btn--ghost" href="#read">{h.actions[1]}</a>
      </div>
    </div>
    <div class="roster rise rise-5" aria-hidden="true">
      <div class="roster-card">
        <div class="roster-head">
          <strong>{r.title}</strong>
          <span>{r.date}</span>
        </div>
        <div class="roster-cols">
          {r.columns.map((c) => <span>{c}</span>)}
        </div>
        <ul class="roster-rows">
          {
            r.rows.map((row) => (
              <li class:list={["roster-row", `is-${row.state}`]}>
                <span class="roster-work">{row.work}</span>
                <span class="roster-who">
                  {row.state === "person" ? (
                    <i class="roster-person">{row.who.slice(0, 1)}</i>
                  ) : (
                    <img src="/icon-small.svg" alt="" width="18" height="18" />
                  )}
                  {row.who}
                </span>
                <span class="roster-now">
                  {row.state === "ask" ? (
                    <>
                      <em class="roster-asked">{row.now}</em>
                      <em class="roster-cleared">{row.cleared}</em>
                    </>
                  ) : (
                    row.now
                  )}
                </span>
              </li>
            ))
          }
        </ul>
        <div class="roster-total">
          <span>{r.total.label}</span>
          <strong>
            {r.total.value}
            <small>{r.total.unit}</small>
          </strong>
        </div>
      </div>
      <div class="roster-phone">
        <div class="roster-phone-head">
          <img src="/icon-small.svg" alt="" width="20" height="20" />
          <strong>{p.from}</strong>
          <span>{p.time}</span>
        </div>
        <p>{p.text}</p>
        <div class="roster-phone-actions">
          <span class="roster-approve">
            <em class="roster-approve-ask">{p.approve}</em>
            <em class="roster-approve-done">✓ {p.approved}</em>
          </span>
          <span class="roster-hold">{p.hold}</span>
        </div>
      </div>
    </div>
  </div>
</section>
