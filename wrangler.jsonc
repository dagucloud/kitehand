{
  // kitehand.ai: the static site in dist/, with the Worker answering /api/*.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitehand",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "kitehand.ai", "custom_domain": true }],
  // Handed-over jobs, and the day's count of diagnoses.
  "kv_namespaces": [{ "binding": "STORE", "id": "630fa7fda84f4f3fa89ad431ec3d1cff" }],
  // Diagnoses per visitor: six a minute.
  "ratelimits": [{ "name": "DIAGNOSE_LIMIT", "namespace_id": "1101", "simple": { "limit": 6, "period": 60 } }],
  "vars": { "DAILY_DIAGNOSES": "3000" },
  "observability": { "enabled": true }
}
