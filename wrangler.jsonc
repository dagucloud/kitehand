{
  // kitehand.ai: the static site in dist/, served as a Worker's assets. The
  // Worker runs only for the home pages, which show the ranking.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitehand",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/ja/"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "kitehand.ai", "custom_domain": true }]
}
