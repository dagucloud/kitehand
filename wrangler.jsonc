{
  // kitehand.ai: the static site in dist/, served as a Worker's assets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitehand",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "kitehand.ai", "custom_domain": true }]
}
